    {
        "id": "b050000000000003",
        "type": "function",
        "z": "b050000000000001",
        "name": "Configurar consulta HTTPS",
        "func": "const key = (env.get(\"OPENWEATHER_API_KEY\") || \"\").trim();\nif (!key) {\n    return [null, { payload: \"Meteorología: falta OPENWEATHER_API_KEY\" }];\n}\nconst city = (env.get(\"OPENWEATHER_CITY\") || \"Vigo,ES\").trim() || \"Vigo,ES\";\nconst url = \"https://api.openweathermap.org/data/2.5/weather\"\n    + \"?q=\" + encodeURIComponent(city)\n    + \"&units=metric&lang=es&appid=\" + encodeURIComponent(key);\nreturn [{ url, requestTimeout: 10000 }, null];",
        "outputs": 2,
        "noerr": 0,
        "x": 390,
        "y": 80,
        "wires": [
            [
                "b050000000000004"
            ],
            [
                "b050000000000006",
                "b050000000000007"
            ]
        ]
    },
    {
        "id": "b050000000000004",
        "type": "http request",
        "z": "b050000000000001",
        "name": "OpenWeatherMap",
        "method": "GET",
        "ret": "obj",
        "url": "",
        "persist": false,
        "senderr": false,
        "headers": [],
        "x": 640,
        "y": 60,
