        "info": "Conectar con Link Out desde Part 4 que entregue msg.topic=\"bunkeros/weather\" y msg.payload={ciudad:\"Vigo\",temperatura:18,descripcion:\"Nublado\",lluvia:false}"
    },
    {
        "id": "b37500000000000d",
        "type": "function",
        "z": "b375000000000001",
        "name": "Telemetría + multialertas + simulación independiente",
        "func": "// BunkerOS · Cloud P1. Este bloque NO controla actuadores físicos.\n// Entradas reales: msg.topic=bunkeros/live y objeto {temperatura,humedad,nivelAgua,puertaAbierta,fugaAgua}\n// Clima: msg.topic=bunkeros/weather y objeto {ciudad,temperatura,descripcion,lluvia}\n// Simulación: msg.topic=bunkeros/demo; tick, {action:toggle,key}, {action:all}, {action:reset}\nconst keys=['calor','humedad','agua','puerta','fuga'];\nconst makeFlags=()=>({calor:false,humedad:false,agua:false,puerta:false,fuga:false});\nconst makeEmpty=()=>({temperatura:null,humedad:null,nivelAgua:null,puertaAbierta:null,fugaAgua:null});\nlet s=context.get('bunkerV3')||{mode:'demo',data:makeEmpty(),demoFlags:makeFlags(),history:[],events:[],flags:[],meteo:null,lastUpdate:null};\nif(!s.demoFlags) s.demoFlags=makeFlags();\nconst p=msg.payload, now=Date.now();\nconst event=(text,level='info')=>{s.events.unshift({ts:now,text,level});s.events=s.events.slice(0,20);};\nconst finite=(v,min,max)=>typeof v==='number'&&Number.isFinite(v)?Math.max(min,Math.min(max,v)):null;\nfunction apply(q){\n for(const [k,min,max] of [['temperatura',-30,80],['humedad',0,100],['nivelAgua',0,100]]){\n  if(Object.prototype.hasOwnProperty.call(q,k))s.data[k]=finite(q[k],min,max);\n }\n for(const k of ['puertaAbierta','fugaAgua']){\n  if(Object.prototype.hasOwnProperty.call(q,k))s.data[k]=typeof q[k]==='boolean'?q[k]:null;\n }\n}\nlet measurement=false;\nif(msg.topic==='bunkeros/weather'){\n if(!p||typeof p!=='object'||Array.isArray(p))return null;\n s.meteo={ciudad:String(p.ciudad||'Localidad'),temperatura:finite(p.temperatura,-80,80),descripcion:String(p.descripcion||'Sin descripción'),lluvia:typeof p.lluvia==='boolean'?p.lluvia:null,ts:now};\n}else if(msg.topic==='bunkeros/demo'){\n if(p==='tick'&&s.mode==='live')return null;\n if(s.mode==='live')return null; // se evita mezclar datos reales y pruebas\n if(p!=='tick'){\n  if(!p||typeof p!=='object'||Array.isArray(p))return null;\n  if(p.action==='reset'){\n   s.demoFlags=makeFlags();event('Simulación restablecida');\n  }else if(p.action==='all'){\n   s.demoFlags=Object.fromEntries(keys.map(k=>[k,true]));event('Prueba combinada: todas las condiciones activadas','warning');\n  }else if(p.action==='toggle'&&keys.includes(p.key)){\n   s.demoFlags[p.key]=!s.demoFlags[p.key];event((s.demoFlags[p.key]?'Activada':'Desactivada')+' condición de prueba: '+p.key);\n  }else return null;\n }\n const f=s.demoFlags;\n const jitter=(x,delta)=>Math.round((x+(Math.random()-.5)*delta)*10)/10;\n apply({temperatura:jitter(f.calor?34:23.5,.8),humedad:jitter(f.humedad?74:53,1.6),nivelAgua:jitter(f.agua?14:78,1.4),puertaAbierta:!!f.puerta,fugaAgua:!!f.fuga});\n measurement=true;\n}else if(msg.topic==='bunkeros/live'){\n let q=p;\n if(typeof q==='string'){try{q=JSON.parse(q);}catch(e){node.warn('Telemetría JSON no válida');return null;}}\n if(!q||typeof q!=='object'||Array.isArray(q)||!['temperatura','humedad','nivelAgua','puertaAbierta','fugaAgua'].some(k=>Object.prototype.hasOwnProperty.call(q,k)))return null;\n if(s.mode!=='live'){\n  s.mode='live';s.history=[];s.events=[];s.flags=[];s.data=makeEmpty();event('Recepción de telemetría MQTT externa');\n }\n apply(q);measurement=true;\n}else return null;\nconst d=s.data;\nif(measurement){\n s.lastUpdate=now;s.history.push({ts:now,temperatura:d.temperatura,nivelAgua:d.nivelAgua});s.history=s.history.slice(-50);\n}\nconst rules=[\n {id:'calor',active:d.temperatura!==null&&d.temperatura>=30,text:'Temperatura elevada',level:'warning'},\n {id:'humedad',active:d.humedad!==null&&d.humedad>=70,text:'Humedad elevada',level:'warning'},\n {id:'agua',active:d.nivelAgua!==null&&d.nivelAgua<=20,text:'Reserva de agua baja',level:'warning'},\n {id:'puerta',active:d.puertaAbierta===true,text:'Puerta abierta',level:'warning'},\n {id:'fuga',active:d.fugaAgua===true,text:'Fuga de agua detectada',level:'critical'}\n];\nconst flags=rules.filter(r=>r.active).map(r=>r.id);\nfor(const r of rules){\n if(r.active&&!s.flags.includes(r.id))event(r.text,r.level);\n if(!r.active&&s.flags.includes(r.id))event('Alerta desactivada: '+r.text,'info');\n}\ns.flags=flags;\nif(!s.events.length&&measurement)event('Monitorización inicializada');\ncontext.set('bunkerV3',s);\nmsg.payload={...s,alerts:rules.filter(r=>r.active),complete:Object.values(d).every(v=>v!==null)};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
        "y": 325,
        "wires": [
            [
                "b37500000000000e",
                "b37500000000000f"
            ]
        ],
        "info": "La simulación usa 5 flags independientes: calor, humedad, agua, puerta y fuga. Se combinan; los umbrales son didácticos. Entrada MQTT / OpenWeatherMap por Link In."
    },
