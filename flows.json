    {
        "id": "b050000000000005",
        "type": "function",
        "z": "b050000000000001",
        "name": "Validar y formatear",
        "func": "const data = msg.payload;\nif (msg.statusCode !== 200) {\n    const hint = {\n        401: \"verifica la activación de la clave\",\n        404: \"revisa OPENWEATHER_CITY\",\n        429: \"límite de consultas alcanzado\"\n    }[msg.statusCode];\n    return { payload: \"Meteorología no disponible (HTTP \" + msg.statusCode\n        + (hint ? \": \" + hint : \"\") + \")\" };\n}\nif (!data || !Number.isFinite(data.main?.temp)\n    || !Number.isFinite(data.main?.humidity) || !Number.isFinite(data.dt)\n    || !data.name || !data.weather?.[0]?.description) {\n    return { payload: \"Meteorología: respuesta incompleta\" };\n}\nconst weather = {\n    city: data.name,\n    country: data.sys?.country,\n    temperatureC: data.main.temp,\n    humidityPct: data.main.humidity,\n    description: data.weather[0].description,\n    observedAt: new Date(data.dt * 1000).toISOString()\n};\nconst time = new Intl.DateTimeFormat(\"es-ES\", {\n    timeZone: \"Europe/Madrid\", hour: \"2-digit\", minute: \"2-digit\",\n    day: \"2-digit\", month: \"2-digit\"\n}).format(new Date(weather.observedAt));\nreturn {\n    weather,\n    payload: weather.city + \" · \" + weather.temperatureC.toFixed(1) + \" °C · \"\n        + weather.humidityPct + \" % HR · \" + weather.description + \" · \" + time\n};",
        "outputs": 1,
        "noerr": 0,
        "x": 860,
        "y": 60,
        "wires": [
            [
                "b050000000000006",
                "b050000000000007"
            ]
        ]
    },
