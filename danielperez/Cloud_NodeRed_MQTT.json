    {
        "id": "69c7262270f16857",
        "type": "function",
        "z": "1b859f4dae59ebcc",
        "name": "Control escenarios",
        "func": "\nlet estados = flow.get(\"escenarios\") || {\n    calor: false,\n    humedad: false,\n    reservaBaja: false,\n    fuga: false,\n    escotillaAbierta: false\n};\n\nconst comando = msg.payload;\n\nif (comando === \"reset\") {\n    estados = {\n        calor: false,\n        humedad: false,\n        reservaBaja: false,\n        fuga: false,\n        escotillaAbierta: false\n    };\n}\nelse if (Object.hasOwn(estados, comando)) {\n    estados[comando] = !estados[comando];\n}\n\nflow.set(\"escenarios\", estados);\n\nmsg.payload = estados;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
