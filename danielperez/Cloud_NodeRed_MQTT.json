    {
        "id": "01db235866c96933",
        "type": "function",
        "z": "1b859f4dae59ebcc",
        "name": "Simulador Esp32-Hidrico",
        "func": "const s = flow.get(\"escenarios\") || {};\n\nconst nivel = s.reservaBaja\n    ? 12 + Math.random() * 3\n    : 75 + Math.random() * 10;\n\nmsg.topic = \"bunker/g5/telemetria/hidrico\";\n\nmsg.payload = {\n    device_id: \"esp32-water-01\",\n    tank_level_pct: Number(nivel.toFixed(1)),\n    leak_detected: !!s.fuga,\n    valve_state: s.fuga ? \"CLOSED\" : \"OPEN\",\n    timestamp: new Date().toISOString()\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
