    {
        "id": "7267f0f4394919df",
        "type": "function",
        "z": "1b859f4dae59ebcc",
        "name": "Simulador Esp32-ambiente",
        "func": "const s = flow.get(\"escenarios\") || {};\n\nconst temperatura = s.calor\n    ? 34 + Math.random()\n    : 23 + Math.random() * 3;\n\nconst humedad = s.humedad\n    ? 78 + Math.random()\n    : 50 + Math.random() * 10;\n\nmsg.topic = \"bunker/g5/telemetria/ambiente\";\n\nmsg.payload = {\n    device_id: \"esp32-env-01\",\n    temperature_c: Number(temperatura.toFixed(1)),\n    humidity_pct: Number(humedad.toFixed(1)),\n    gas_ppm: 120,\n    fan_state: s.calor ? \"ON\" : \"OFF\",\n    timestamp: new Date().toISOString()\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
