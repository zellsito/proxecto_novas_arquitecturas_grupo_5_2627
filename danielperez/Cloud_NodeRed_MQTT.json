    {
        "id": "331b720ca329b7d0",
        "type": "function",
        "z": "1b859f4dae59ebcc",
        "name": "Alerta de fuga",
        "func": "const fuga = msg.payload.leak_detected;\n\nconst anterior = flow.get(\"fugaAnterior\");\n\nif (anterior === fuga) {\n    return null;\n}\n\nflow.set(\"fugaAnterior\", fuga);\n\nmsg.topic = \"bunker/g5/alerta/fuga\";\n\nif (fuga) {\n    msg.payload = {\n        device_id: \"esp32-water-01\",\n        severity: \"CRITICAL\",\n        event: \"WATER_LEAK_TRIGGERED\",\n        action_taken: \"VALVE_CLOSED_IMMEDIATELY\",\n        timestamp: new Date().toISOString()\n    };\n} else {\n    msg.payload = {\n        device_id: \"esp32-water-01\",\n        severity: \"INFO\",\n        event: \"WATER_LEAK_CLEARED\",\n        action_taken: \"NONE\",\n        timestamp: new Date().toISOString()\n    };\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
